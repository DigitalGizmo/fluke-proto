# Review build: online assets, attract loop on. Not a kiosk build — images still
# come from the CDN.
VITE_BASE_URL=/fluke-id/
VITE_IMAGE_BASE=https://assets.digitalgizmo.com/fluke-id
VITE_ATTRACT=true
# Unattended, so it recovers on its own. With VITE_ATTRACT=true the idle reset
# returns to the attract loop. Seconds; 0 would disable it.
VITE_IDLE_TIMEOUT=300

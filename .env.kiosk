# Kiosk build: attract loop on, everything served locally. Relative paths so it
# works when loaded from disk rather than a web root.
VITE_BASE_URL=./
VITE_IMAGE_BASE=./images
VITE_ATTRACT=true
# Shorter than review: an unattended floor machine should be back on the
# attract loop soon after a visitor walks away. Seconds; 0 would disable it.
VITE_IDLE_TIMEOUT=120

# Kiosk build: attract loop on, everything served locally. Relative paths so it
# works when loaded from disk rather than a web root.
VITE_BASE_URL=./
VITE_IMAGE_BASE=./images
VITE_ATTRACT=true
# An unattended floor machine should return to the attract loop once a visitor
# steps away, but this one has reading to do (the Tips panel, the reveal copy),
# so it is not aggressive. Kept in step with .env.review, which mirrors the
# kiosk experience. Seconds; 0 would disable it.
VITE_IDLE_TIMEOUT=90

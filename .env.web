# Web build: online assets, no attract loop, no idle reset.
# A page someone opens in their own browser should stay where they left it, so
# this build never resets itself. Contrast .env.review / .env.kiosk, which run
# unattended and do need to recover for the next visitor.
VITE_BASE_URL=/fluke-id/
VITE_IMAGE_BASE=https://assets.digitalgizmo.com/fluke-id
VITE_ATTRACT=false
